---
import Base from '../layouts/Base.astro';
import { lien } from '../lib/lien';
import { ouvert, rsvpFerme } from '../lib/ouverture';
---

<Base titre="Bienvenue" porte>
  <main class="page porte">
    <div class="porte__bandeau">
      <span>Sur invitation</span>
      <span>22 · 05 · 2027</span>
    </div>
    <div class="pousse"></div>
    <p class="porte__monogramme" aria-hidden="true">T<em class="esperluette">&amp;</em>F</p>
    <h1 class="porte__bienvenue">Bienvenue</h1>
    <p class="porte__texte">Ce site accompagne le mariage de Tsiry &amp; Fy Tia, avant, pendant et après le grand jour.</p>
    <div class="pousse"></div>
    <form class="porte__formulaire" action={lien('/couverture/')} method="get" data-porte>
      <label class="surtitre surtitre--gris" for="mdp">Mot de passe</label>
      <input
        class="champ__saisie"
        id="mdp"
        type="password"
        autocomplete="current-password"
        autocapitalize="none"
        spellcheck="false"
        placeholder={rsvpFerme ? '' : 'Indiqué sur votre faire-part'}
      />
      <p class="porte__erreur" role="alert" data-erreur hidden>Ce n'est pas le bon mot de passe.</p>
      <button class="bouton" type="submit">Entrer</button>
      <p class="porte__aide">
        {rsvpFerme ? 'Pas de mot de passe ? Demandez-le aux mariés.' : 'Le QR code de votre faire-part vous fait entrer directement, sans mot de passe.'}
      </p>
    </form>
    {
      !ouvert && (
        <p class="porte__apercu">
          Aperçu de présentation : n'importe quel mot de passe ouvre la porte.
          <a href={lien('/faire-part/')}>Voir aussi le faire-part</a>
        </p>
      )
    }
  </main>
</Base>

<script>
  import { codeDuFoyer } from '../lib/foyer';
  import { lien } from '../lib/lien';
  import { empreinteMotDePasse } from '../lib/mot-de-passe.js';
  import { empreinte, ouvert, rsvpFerme } from '../lib/ouverture';

  const parQr = new URLSearchParams(location.search).has('f');

  /** La page d'où la garde a renvoyé (src/layouts/Base.astro), sinon la couverture. */
  function suite(): string {
    try {
      const chemin = sessionStorage.getItem('suite');
      sessionStorage.removeItem('suite');
      if (chemin && chemin.startsWith(lien('/')) && !chemin.startsWith('//')) return chemin;
    } catch {
      // Pas de stockage : la couverture.
    }
    return lien('/couverture/');
  }

  function entrer() {
    try {
      localStorage.setItem('entree', empreinte);
    } catch {
      // Navigation privée stricte : la garde ne retient personne non plus.
    }
    location.replace(suite());
  }

  function dejaEntre(): boolean {
    try {
      return localStorage.getItem('entree') === empreinte;
    } catch {
      return false;
    }
  }

  if (!ouvert) {
    // Aperçu : le QR du faire-part porte le code du foyer (?f=CODE), il le garde et entre sans mot de passe.
    if (parQr && codeDuFoyer()) location.replace(lien('/couverture/'));
  } else {
    if (dejaEntre()) location.replace(suite());
    // Le QR n'ouvre la porte qu'avec le RSVP, quand les codes de foyer existent (#2008).
    else if (!rsvpFerme && parQr && codeDuFoyer()) entrer();

    const formulaire = document.querySelector<HTMLFormElement>('[data-porte]');
    const champ = document.querySelector<HTMLInputElement>('#mdp');
    const erreur = document.querySelector<HTMLElement>('[data-erreur]');
    champ?.addEventListener('input', () => {
      if (erreur) erreur.hidden = true;
    });
    formulaire?.addEventListener('submit', async (evenement) => {
      evenement.preventDefault();
      if (champ && (await empreinteMotDePasse(champ.value)) === empreinte) {
        entrer();
        return;
      }
      if (erreur) erreur.hidden = false;
      champ?.select();
    });
  }
</script>

<style>
  .porte {
    padding: 28px 28px 24px;
  }

  .porte__bandeau {
    display: flex;
    justify-content: space-between;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--filet);
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gris);
  }

  .porte__monogramme {
    margin: 0;
    text-align: center;
    font-family: var(--serif);
    font-size: 120px;
    line-height: 0.9;
  }

  .porte__bienvenue {
    margin: 22px 0 0;
    text-align: center;
    font-family: var(--serif);
    font-style: italic;
    font-weight: 400;
    font-size: 28px;
  }

  .porte__texte {
    margin: 10px auto 0;
    max-width: 290px;
    text-align: center;
    font-size: 15px;
    color: var(--encre-douce);
  }

  .porte__formulaire {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .porte__formulaire .bouton {
    margin-top: 12px;
  }

  .porte__erreur {
    margin: 10px 0 0;
    font-size: 14px;
    color: var(--encre);
  }

  .porte__erreur[hidden] {
    display: none;
  }

  .porte__aide {
    margin: 16px 0 0;
    text-align: center;
    font-size: 13px;
    line-height: 1.5;
    color: var(--gris);
  }

  .porte__apercu {
    margin: 28px 0 0;
    padding-top: 14px;
    border-top: 1px dashed var(--filet);
    text-align: center;
    font-size: 12px;
    line-height: 1.5;
    color: var(--gris);
  }
</style>

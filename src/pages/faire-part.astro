---
import Base from '../layouts/Base.astro';
import { lien } from '../lib/lien';

---

<Base titre="Faire-part" fond="var(--ciel)">
  <p class="apercu">Aperçu du faire-part, format A5 (148 × 210 mm), recto puis verso. <a href={lien('/')}>Retour au site</a></p>
  <main class="fp">
    <div class="fp__cadre" data-cadre>
      <article class="fp__carte fp__recto" aria-label="Recto du faire-part">
        <img class="fp__deco fp__napperon" src={lien('/faire-part/coeur-dentelle.webp')} alt="" />
        <img class="fp__deco fp__amarante" src={lien('/faire-part/amarante.webp')} alt="" />
        <p class="fp__mono" aria-hidden="true">tf.</p>
        <h1 class="fp__couple">Tsiry &amp; Fy Tia</h1>
        <p class="fp__parents">
          avec l'amour de leurs parents<br />
          <strong>Faly et Herilantosoa Ravelojaona</strong><br />
          <strong>&amp; Vola Andrianirina</strong>
        </p>
        <p class="fp__joie">ont la joie de t'inviter<br />à leur mariage</p>
        <p class="fp__chiffres" aria-label="Le 22 mai 2027">22<br />05<br />27</p>
        <img class="fp__deco fp__coeur" src={lien('/faire-part/coeur-dentelle-rose.webp')} alt="" />
        <img class="fp__deco fp__arum" src={lien('/faire-part/arum.webp')} alt="" />
        <a class="fp__enveloppe" href={lien('/')}>
          <img class="fp__deco" src={lien('/faire-part/enveloppe-etoiles.webp')} alt="" />
          <span>découvrir notre<br />site de mariage</span>
        </a>
        <img class="fp__deco fp__hortensia" src={lien('/faire-part/hortensia.webp')} alt="" />
        <a class="fp__rsvp" href={lien('/rsvp/')}>
          <svg class="fp__epingle" aria-hidden="true" width="26" height="30" viewBox="0 0 26 30">
            <defs>
              <radialGradient id="perle" cx="0.35" cy="0.32" r="0.75">
                <stop offset="0" stop-color="#ffffff" />
                <stop offset="0.55" stop-color="#efe6d6" />
                <stop offset="1" stop-color="#b9ab92" />
              </radialGradient>
            </defs>
            <line x1="9" y1="9" x2="22" y2="28" stroke="#8a8f96" stroke-width="1.6" stroke-linecap="round" />
            <circle cx="9" cy="9" r="7.5" fill="url(#perle)" />
          </svg>
          rsvp
        </a>
      </article>
    </div>

    <div class="fp__cadre" data-cadre>
      <article class="fp__carte" aria-label="Verso du faire-part">
        <div class="fp__bandeau"><span>L'invitation</span><span class="monogramme">T<em>&amp;</em>F</span></div>
        <div class="fp__quand-ou">
          <div>
            <p class="surtitre">Quand</p>
            <p class="fp__info">Samedi 22 mai 2027</p>
            <p class="fp__detail">Cérémonie à 14 h</p>
          </div>
          <div>
            <p class="surtitre">Où</p>
            <p class="fp__info">Domaine Verdé</p>
            <p class="fp__detail">1660 route de Bouloc<br />31340 Vacquiers</p>
          </div>
        </div>
        <p class="fp__suite">Cocktail, dîner et soirée dansante, puis brunch le dimanche 23 mai.</p>
        <div class="pousse"></div>
        <div class="fp__qr-bloc">
          <div class="fp__qr">
            <svg aria-hidden="true" width="150" height="150" viewBox="0 0 150 150"><rect x="12" y="12" width="30" height="30" fill="none" stroke="#004672" stroke-width="4"></rect><rect x="21" y="21" width="12" height="12" fill="#004672"></rect><rect x="108" y="12" width="30" height="30" fill="none" stroke="#004672" stroke-width="4"></rect><rect x="117" y="21" width="12" height="12" fill="#004672"></rect><rect x="12" y="108" width="30" height="30" fill="none" stroke="#004672" stroke-width="4"></rect><rect x="21" y="117" width="12" height="12" fill="#004672"></rect></svg>
            <span>[QR code]</span>
          </div>
          <div>
            <p class="surtitre">Tout le reste est en ligne</p>
            <p class="fp__qr-texte">Programme, accès, dress code, et votre réponse avant le 22 février 2027.</p>
            <p class="fp__adresse">[adresse-du-site.fr]</p>
            <p class="fp__mdp">Mot de passe : [à définir]</p>
          </div>
        </div>
        <p class="fp__blanc">Laissez le blanc aux mariés.</p>
      </article>
    </div>
  </main>
</Base>

<script>
  // La carte est dessinée à sa taille réelle (559 × 794 px) puis mise à l'échelle de son cadre.
  // Pas de `zoom` : Safari le calcule autrement que Chrome (carte plus large que son cadre,
  // verso rogné), et sur iPhone la page ne défilait plus en portrait.
  const observateur = new ResizeObserver((entrees) => {
    entrees.forEach(({ target }) => {
      const cadre = target as HTMLElement;
      cadre.style.setProperty('--echelle', String(cadre.clientWidth / 559));
    });
  });
  document.querySelectorAll<HTMLElement>('[data-cadre]').forEach((cadre) => observateur.observe(cadre));
</script>

<style>
  .fp {
    max-width: 600px;
    margin: 0 auto;
    padding: 20px 16px 40px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .fp__cadre {
    position: relative;
    width: 100%;
    aspect-ratio: 559 / 794;
    overflow: hidden;
    box-shadow: 0 1px 3px rgba(0, 70, 114, 0.18);
  }

  .fp__carte {
    position: absolute;
    top: 0;
    left: 0;
    transform: scale(var(--echelle, 1));
    transform-origin: 0 0;
    width: 559px;
    height: 794px;
    padding: 44px 56px 48px;
    display: flex;
    flex-direction: column;
    background: var(--papier);
    color: var(--encre);
  }

  .fp__bandeau {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--encre);
    font-size: 12px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }

  .fp__bandeau .monogramme {
    letter-spacing: 0;
    text-transform: none;
  }














  /* Recto en collage, d'après la maquette de Fy Tia (20/11). Coordonnées en px de la carte
     (559 × 794), relevées sur sa maquette à 1409 px de large (facteur 0,397). */
  .fp__recto {
    padding: 0;
    display: block;
    overflow: hidden;
    background: #d6e8fa;
  }

  .fp__recto > * {
    position: absolute;
    margin: 0;
  }

  .fp__deco {
    max-width: none;
    pointer-events: none;
    filter: drop-shadow(0 6px 8px rgba(0, 50, 100, 0.25));
  }

  .fp__napperon {
    left: -205px;
    top: 168px;
    width: 330px;
    opacity: 0.7;
    transform: rotate(-80deg);
    filter: none;
  }

  .fp__amarante {
    left: -160px;
    top: -6px;
    width: 258px;
    transform: rotate(5deg);
    filter: drop-shadow(7px 9px 6px rgba(0, 50, 100, 0.3));
  }

  .fp__mono {
    top: 28px;
    right: 38px;
    font-family: var(--serif);
    font-size: 54px;
    line-height: 1;
    letter-spacing: -0.03em;
    text-shadow: 0 2px 3px rgba(0, 40, 80, 0.25);
  }

  .fp__couple {
    top: 196px;
    right: 64px;
    font-family: var(--serif);
    font-weight: 400;
    font-size: 58px;
    line-height: 1;
    white-space: nowrap;
    text-shadow: 0 2px 3px rgba(0, 40, 80, 0.2);
  }

  .fp__parents {
    top: 290px;
    right: 58px;
    text-align: right;
    font-size: 16.5px;
    line-height: 1.45;
  }

  .fp__parents strong {
    font-weight: 700;
    font-style: italic;
  }

  .fp__joie {
    top: 380px;
    right: 58px;
    text-align: right;
    font-family: var(--serif);
    font-size: 33px;
    line-height: 0.95;
    letter-spacing: -0.02em;
  }

  .fp__chiffres {
    left: 14px;
    top: 498px;
    font-family: var(--serif);
    font-size: 112px;
    line-height: 0.82;
    text-shadow:
      0 0 2px #fff,
      0 0 6px #fff;
  }

  .fp__coeur {
    left: 300px;
    top: 583px;
    width: 290px;
    transform: rotate(-14deg);
  }

  .fp__arum {
    left: 381px;
    top: 520px;
    width: 196px;
    transform: scaleX(-1);
  }

  .fp__enveloppe {
    left: 132px;
    top: 618px;
    width: 206px;
    transform: rotate(-9deg);
    color: var(--encre);
    text-decoration: none;
  }

  .fp__enveloppe img {
    display: block;
    width: 100%;
  }

  /* Le texte se pose sur la carte, à la place de la zone floue de la photo d'origine. */
  .fp__enveloppe span {
    position: absolute;
    left: 10%;
    top: 27%;
    width: 80%;
    padding: 6px 4px;
    text-align: center;
    font-family: var(--serif);
    font-size: 21px;
    line-height: 1.02;
    background: radial-gradient(closest-side, #eceddf 72%, rgba(236, 237, 223, 0));
  }

  .fp__hortensia {
    left: 312px;
    top: 650px;
    width: 258px;
  }

  .fp__rsvp {
    left: 362px;
    top: 659px;
    width: 108px;
    height: 37px;
    border-radius: 8px;
    background: rgba(84, 132, 180, 0.9);
    box-shadow: 0 4px 8px rgba(0, 50, 100, 0.25);
    color: #fff;
    text-align: center;
    font-family: var(--serif);
    font-size: 26px;
    line-height: 34px;
    text-decoration: none;
  }

  .fp__epingle {
    position: absolute;
    left: 30px;
    top: -17px;
  }

  .fp__quand-ou {
    padding: 32px 0 22px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    border-bottom: 1px solid var(--encre);
  }

  .fp__quand-ou p {
    margin: 0;
  }

  .fp__info {
    margin-top: 8px !important;
    font-family: var(--serif);
    font-size: 26px;
    line-height: 1.15;
  }

  .fp__detail {
    margin-top: 6px !important;
    font-size: 15px;
    line-height: 1.5;
  }

  .fp__suite {
    margin: 18px 0 0;
    font-size: 15px;
    color: var(--encre-douce);
  }

  .fp__qr-bloc {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .fp__qr-bloc p {
    margin: 0;
  }

  .fp__qr {
    position: relative;
    flex-shrink: 0;
    width: 150px;
    height: 150px;
    border: 1px solid var(--encre);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--encre-douce);
  }

  .fp__qr svg {
    position: absolute;
    left: -1px;
    top: -1px;
  }

  .fp__qr-texte {
    margin-top: 8px !important;
    font-size: 16px;
    line-height: 1.55;
  }

  .fp__adresse {
    margin-top: 10px !important;
    font-family: var(--serif);
    font-style: italic;
    font-size: 20px;
  }

  .fp__mdp {
    margin-top: 4px !important;
    font-size: 13px;
    color: var(--gris);
  }

  .fp__blanc {
    margin: 30px 0 0;
    padding-top: 14px;
    border-top: 1px solid var(--filet);
    text-align: center;
    font-family: var(--serif);
    font-style: italic;
    font-size: 18px;
    color: var(--accent);
  }
</style>

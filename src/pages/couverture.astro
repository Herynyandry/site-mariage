---
import Base from '../layouts/Base.astro';
import { lien } from '../lib/lien';
import { rsvpFerme } from '../lib/ouverture';

const rubriques = [
  { href: lien('/programme/'), titre: "10 ans d'amour, et le programme" },
  { href: lien('/dress-code/'), titre: 'Dress code : tout sauf le blanc' },
  { href: lien('/infos/'), titre: 'Venir, se garer, vos questions' },
  { href: lien('/chasse/'), titre: 'Jour J : la chasse aux photos' },
  { href: lien('/livre-d-or/'), titre: "Le livre d'or, un carré chacun" },
];
---

<Base titre="Couverture" fond="#004672">
  <main class="couv">
    <div class="couv__contenu">
      <div class="couv__bandeau">
        <span>Numéro unique</span>
        <span>Mai 2027</span>
      </div>
      <h1 class="couv__noms">
        <span>Tsiry</span>
        <span class="couv__ligne2"><em>&amp;</em> Fy Tia</span>
      </h1>
      <div class="couv__cadre">
        <img class="couv__photo" src={lien('/photos/couverture-bague.jpg')} alt="Selfie de Tsiry et Fy Tia, la bague bien visible" />
      </div>
      <div class="pousse"></div>
      <p class="couv__surtitre">Le grand jour</p>
      <p class="couv__date">Samedi 22 mai 2027</p>
      <p class="couv__lieu">Domaine Verdé · Vacquiers</p>
      <nav class="couv__sommaire" aria-label="Sommaire">
        {
          rubriques.map((r, i) => (
            <a href={r.href}>
              <span class="couv__num">{String(i + 1).padStart(2, '0')}</span>
              <span>{r.titre}</span>
            </a>
          ))
        }
      </nav>
      {
        rsvpFerme ? (
          <p class="couv__rsvp couv__rsvp--bientot">Le RSVP arrivera avec votre faire-part.</p>
        ) : (
          <a class="bouton bouton--papier couv__rsvp" href={lien('/rsvp/')}>
            Répondre avant le 22 février
          </a>
        )
      }
    </div>
  </main>
</Base>

<style>
  .couv {
    position: relative;
    max-width: 520px;
    min-height: 100dvh;
    margin: 0 auto;
    overflow: hidden;
    background: var(--encre);
    color: var(--papier);
  }

  /* La photo d'accueil est un selfie en gros plan (choix de Fy Tia, 20/11) : en fond plein écran,
     le recadrage coupait un visage et le sommaire le recouvrait. Elle prend donc toute la largeur,
     entière, entre les noms (qui mordent sur le plafond) et la date (qui mord sur le bas). */
  .couv__cadre {
    position: relative;
    margin: -44px -22px 0;
  }

  .couv__cadre::before,
  .couv__cadre::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
  }

  .couv__cadre::before {
    top: 0;
    height: 28%;
    background: linear-gradient(rgba(0, 70, 114, 1), rgba(0, 70, 114, 0));
  }

  .couv__cadre::after {
    bottom: 0;
    height: 34%;
    background: linear-gradient(rgba(0, 70, 114, 0), rgba(0, 70, 114, 1));
  }

  .couv__photo {
    display: block;
    width: 100%;
    max-width: none;
    aspect-ratio: 3 / 4;
    object-fit: cover;
  }

  .couv__contenu {
    position: relative;
    min-height: 100dvh;
    padding: 20px 22px 24px;
    display: flex;
    flex-direction: column;
  }

  .couv__bandeau {
    display: flex;
    justify-content: space-between;
    padding-bottom: 10px;
    border-bottom: 1px solid rgba(255, 244, 233, 0.45);
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .couv__noms {
    position: relative;
    z-index: 1;
    margin: 14px 0 0;
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(64px, 21.5vw, 104px);
    line-height: 0.86;
    letter-spacing: -0.02em;
  }

  .couv__noms span {
    display: block;
  }

  .couv__ligne2 {
    text-align: right;
  }

  .couv__ligne2 em {
    font-weight: 400;
    color: var(--rose);
  }

  /* Date, lieu : posés sur le dégradé du bas de la photo. */
  .couv__surtitre,
  .couv__date,
  .couv__lieu {
    position: relative;
  }

  .couv__surtitre {
    margin: -64px 0 0;
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--rose);
  }

  .couv__date {
    margin: 6px 0 0;
    font-family: var(--serif);
    font-style: italic;
    font-size: 30px;
    line-height: 1.1;
  }

  .couv__lieu {
    margin: 4px 0 18px;
    font-size: 15px;
  }

  .couv__sommaire {
    display: flex;
    flex-direction: column;
    border-top: 1px solid rgba(255, 244, 233, 0.45);
  }

  .couv__sommaire a {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 44px;
    border-bottom: 1px solid rgba(255, 244, 233, 0.2);
    color: var(--papier);
    text-decoration: none;
    font-size: 15px;
  }

  .couv__sommaire a:hover {
    color: var(--rose);
  }

  .couv__num {
    width: 18px;
    font-size: 11px;
    letter-spacing: 0.12em;
    color: var(--rose);
  }

  .couv__rsvp {
    margin-top: 18px;
  }

  .couv__rsvp--bientot {
    margin-bottom: 0;
    padding-top: 14px;
    border-top: 1px solid rgba(255, 244, 233, 0.35);
    text-align: center;
    font-size: 14px;
    font-style: italic;
  }
</style>

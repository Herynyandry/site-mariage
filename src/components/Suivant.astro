---
interface Props {
  href: string;
  surtitre: string;
  titre: string;
}

const { href, surtitre, titre } = Astro.props;
---

<a class="suivant" href={href}>
  <span class="suivant__textes">
    <span class="surtitre surtitre--gris">{surtitre}</span>
    <span class="suivant__titre">{titre}</span>
  </span>
  <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
</a>
